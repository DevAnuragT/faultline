# Paste the filled-in version into Streamlit Community Cloud > App settings > Secrets.
# (Locally this file is git-ignored; the app reads these as environment variables.)
# All values must be quoted strings.

GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

# FalkorDB Cloud: open your instance > connection details
FALKORDB_HOST = "your-instance-host.falkordb.cloud"
FALKORDB_PORT = "your-port"
FALKORDB_USERNAME = "your-username"
FALKORDB_PASSWORD = "your-password"
FALKORDB_SSL = "true"
